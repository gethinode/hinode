    Visit gethinode.com/license for more details.

    Override of Hugo's embedded RSS template (v0.164.0). The item <description> emits plain
    text — the frontmatter description when set, else a plainified summary — instead
    of the page's rendered HTML. Embedding rendered HTML forces a per-output-format
    content render whose ambient context is the feed page, which made feed bytes
    depend on render order (non-deterministic builds). Plain text strips the
    order-sensitive markup (classes, generated element ids) so feeds are stable.

    It also leaves out every page that utilities/IsIndexable.html rejects, as
    sitemap.xml does, before the RSS limit applies, so the limit counts only the
    pages the feed lists. lastBuildDate is the newest lastmod of those pages, and is
    left out when there are none or that lastmod is zero. Term dates use
    utilities/GetIndexableDates.html so noindex members cannot supply inherited dates.
*/}}
{{- $authorEmail := "" }}
{{- with site.Params.author }}
	{{- if reflect.IsMap . }}
		{{- with .email }}
			{{- $authorEmail = . }}
		{{- end }}
	{{- end }}
{{- end }}

{{- $authorName := "" }}
{{- with site.Params.author }}
	{{- if reflect.IsMap . }}
		{{- with .name }}
			{{- $authorName = . }}
		{{- end }}
	{{- else }}
		{{- $authorName = . }}
	{{- end }}
{{- end }}

{{- $pctx := . }}
{{- if .IsHome }}{{ $pctx = .Site }}{{ end }}
{{- $pages := slice }}
{{- if or $.IsHome $.IsSection }}
	{{- $pages = $pctx.RegularPages }}
{{- else }}
	{{- $pages = $pctx.Pages }}
{{- end }}
{{- /* Walk the pages in their own order and stop at the limit-th indexable one, so the
       pages kept are the first $limit indexable pages, as filtering every page and then
       applying first would give. A limit below 1 means no limit. The noindex pages seen go
       into a map, and complement drops them while it keeps the order and type of $pages;
       appending every kept page to a slice instead copies the slice on each append. */}}
{{- $limit := .Site.Config.Services.RSS.Limit }}
{{- $scanned := 0 }}
{{- $listed := 0 }}
{{- $hidden := newScratch }}
{{- range $pages }}
	{{- $scanned = add $scanned 1 }}
	{{- if partialCached "utilities/IsIndexable.html" . . }}
		{{- $listed = add $listed 1 }}
		{{- if and (ge $limit 1) (ge $listed $limit) }}
			{{- break }}
		{{- end }}
	{{- else }}
		{{- $hidden.SetInMap "pages" (string $scanned) . }}
	{{- end }}
{{- end }}
{{- $pages = $pages | first $scanned }}
{{- with $hidden.GetSortedMapValues "pages" }}
	{{- $pages = $pages | complement . }}
{{- end }}
{{- /* lastBuildDate is the newest lastmod of the listed pages, and is left out when that is
       zero. As in the embedded template, it is also left out when the feed's own date is
       zero, as it is for a section whose _index.md takes its lastmod from Git. */}}
{{- $lastBuildDate := "" }}
{{- with $pages }}
	{{- $lastmod := time.AsTime "0001-01-01T00:00:00Z" }}
	{{- range . }}
		{{- $dates := partialCached "utilities/GetIndexableDates.html" . . }}
		{{- if $dates.lastmod.After $lastmod }}
			{{- $lastmod = $dates.lastmod }}
		{{- end }}
	{{- end }}
	{{- if and (not $.Date.IsZero) (not $lastmod.IsZero) }}
		{{- $lastBuildDate = $lastmod.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}
	{{- end }}
{{- end }}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
	<channel>
		<title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
		<link>{{ .Permalink }}</link>
		<description>Recent content {{ if ne .Title .Site.Title }}{{ with .Title }}in {{ . }} {{ end }}{{ end }}on {{ .Site.Title }}</description>
		<generator>Hugo</generator>
		<language>{{ if le (hugo.Version.Compare "0.158.0") 0 }}{{ site.Language.Locale }}{{ else }}{{ site.Language.LanguageCode }}{{ end }}</language>
		{{ with $authorEmail }}
			<managingEditor>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</managingEditor>
		{{ end }}
		{{ with $authorEmail }}
			<webMaster>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</webMaster>
		{{ end }}
		{{ with .Site.Copyright }}
			<copyright>{{ . }}</copyright>
		{{ end }}
		{{ with $lastBuildDate }}
			<lastBuildDate>{{ . | safeHTML }}</lastBuildDate>
		{{ end }}
		{{- with .OutputFormats.Get "RSS" }}
			{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
		{{- end }}
		{{- range $pages }}
			<item>
				<title>{{ .Title }}</title>
				<link>{{ .Permalink }}</link>
				{{- $dates := partialCached "utilities/GetIndexableDates.html" . . }}
				{{- if or (ne .Kind "term") (not $dates.publishDate.IsZero) }}
				<pubDate>{{ $dates.publishDate.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
				{{- end }}
				{{- with $authorEmail }}<author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>{{ end }}
				<guid>{{ .Permalink }}</guid>
				<description>{{ with .Description }}{{ . | transform.XMLEscape | safeHTML }}{{ else }}{{ .Summary | plainify | htmlUnescape | transform.XMLEscape | safeHTML }}{{ end }}</description>
			</item>
		{{- end }}
	</channel>
</rss>
